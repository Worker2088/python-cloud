{
  "version": 1,
  "disable_existing_loggers": false,

  "filters": {
    "request_context": {
      "()": "src.core.logging.RequestContextFilter"
    }
  },

  "formatters": {
    "json": {
      "()": "pythonjsonlogger.json.JsonFormatter",
      "fmt": "%(asctime)s %(levelname)s %(name)s %(message)s %(request_id)s %(user_id)s %(filename)s %(lineno)d"
    }
  },

  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "filters": ["request_context"],
      "stream": "ext://sys.stdout"
    }
  },

  "root": {
    "level": "INFO",
    "handlers": ["stdout"]
  }
}